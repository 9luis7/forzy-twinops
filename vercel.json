{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{services/twinops/{src/twinops/**,migrations/*.sql},contracts/**,artifacts/ml/real-forzy/{pipeline.joblib,pipeline-config.json,backtest-report.json,model-card.md,feature-manifest.json}}",
      "excludeFiles": "{**/{.agents,test,tests}/**,.env*,.superpowers/**,dist/**,artifacts/{ml/{*.json,*.joblib,*.md,real-forzy/source-summary.json},ml-public/**,twin3d/**},{docs,evals,notebooks,scripts,src,tools}/**,skills-lock.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
