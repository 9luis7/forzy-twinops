# Exemplo de variáveis. Copie para .env e preencha. NUNCA commite o .env real.
# Variáveis do front legado. Nunca commite o .env real.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# service_role NUNCA vai para o front-end nem para o repositório.
VITE_TWINOPS_DATA_MODE=replay
VITE_TWINOPS_API_BASE_URL=

# Coletor/API TwinOps (somente backend)
TWINOPS_UPSTREAM_BASE_URL=
TWINOPS_DATABASE_PATH=var/twinops.sqlite3
TWINOPS_ASSET_TAG=MTR-BMB-042
TWINOPS_POLL_INTERVAL_SECONDS=5
TWINOPS_REQUEST_TIMEOUT_SECONDS=2
TWINOPS_TIMEZONE=America/Sao_Paulo

# ML opcional. Os três valores devem ser definidos juntos.
# Fixe os hashes reais no ambiente de deploy; não confie apenas no manifesto local.
TWINOPS_ML_ARTIFACT_PATH=artifacts/ml/real-forzy
TWINOPS_ML_MANIFEST_HASH=
TWINOPS_ML_MODEL_HASH=
