# TwinOps v2 server-side. Nunca use prefixo VITE_ para estes valores.
DATABASE_URL=
TWINOPS_UPSTREAM_BASE_URL=
TWINOPS_ASSET_ID=forzy-motor-01
TWINOPS_POLL_INTERVAL_SECONDS=5
TWINOPS_REQUEST_TIMEOUT_SECONDS=2
TWINOPS_TIMEZONE=America/Sao_Paulo

# Os três anchors ML devem ser definidos juntos e validados antes do joblib.load.
TWINOPS_ML_ARTIFACT_PATH=artifacts/ml/real-forzy
TWINOPS_ML_MANIFEST_HASH=sha256:fe2cbd7e1b576f04b2c6380e41ecb7c97df7faa5084c39c4b0d16db786afe7f0
TWINOPS_ML_MODEL_HASH=sha256:68d00121edbf8c4c01cf7cd231cd57c4c8eff25661135494e3c791ca78e562ba

# RAG técnico. Permanece desligado até cada gate operacional ser aprovado.
VERCEL_ENV=development
TWINOPS_RAG_ENABLED=false
RAG_ADMIN_ENABLED=false
VITE_RAG_ADMIN_ENABLED=false

# Allowlist explícita usada pelo checker Preview; nunca é inferida do DATABASE_URL.
RAG_PREVIEW_DATABASE_NAME=
RAG_PREVIEW_DATABASE_USER=
RAG_PRODUCTION_DATABASE_NAME=
RAG_PRODUCTION_DATABASE_USER=

# Provedor direto adotado para a demo: a chave Gemini fica somente no backend.
# Para voltar ao Gateway, use TWINOPS_RAG_PROVIDER=gateway, restaure os modelos
# gateway abaixo e use OIDC/AI_GATEWAY_API_KEY. Nunca crie variavel VITE_* de segredo.
TWINOPS_RAG_PROVIDER=gemini
GEMINI_API_KEY=
AI_GATEWAY_API_KEY=
TWINOPS_RAG_MANUFACTURER=
TWINOPS_RAG_EQUIPMENT_MODEL=
TWINOPS_RAG_EMBEDDING_MODEL=gemini-embedding-2
TWINOPS_RAG_EMBEDDING_DIMENSIONS=768
TWINOPS_RAG_GENERATION_MODEL=gemini-3.5-flash-lite
TWINOPS_RAG_GATEWAY_TIMEOUT_SECONDS=10
TWINOPS_RAG_QUERY_TIMEOUT_SECONDS=10
# Historical replay demo: dedicated sessions, additive tables, existing provider.
DEMO_ENABLED=false
