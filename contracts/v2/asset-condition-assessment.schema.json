{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forzy://contracts/v2/asset-condition-assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "assetId", "sensorId", "window", "quality", "operatingContext", "assessment", "componentTag", "recommendation", "humanValidationRequired", "evidence", "model", "limitations"],
  "properties": {
    "schemaVersion": { "const": "2.0" }, "assessmentId": { "$ref": "#/$defs/uuid" }, "assetId": { "const": "forzy-motor-01" }, "sensorId": { "enum": ["s1", "s2"] },
    "window": { "$ref": "#/$defs/window" }, "quality": { "$ref": "#/$defs/quality" }, "operatingContext": { "$ref": "#/$defs/operatingContext" }, "assessment": { "$ref": "#/$defs/detail" },
    "componentTag": { "const": null }, "recommendation": { "type": ["string", "null"] }, "humanValidationRequired": { "type": "boolean" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }, "model": { "$ref": "#/$defs/model" }, "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" }, "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "window": { "type": "object", "additionalProperties": false, "required": ["start", "end", "receivedAt", "freshnessMs"], "properties": { "start": { "$ref": "#/$defs/timestamp" }, "end": { "$ref": "#/$defs/timestamp" }, "receivedAt": { "$ref": "#/$defs/timestamp" }, "freshnessMs": { "type": "number", "minimum": 0 } } },
    "quality": { "type": "object", "additionalProperties": false, "required": ["status", "flags"], "properties": { "status": { "enum": ["ok", "degraded", "insufficient_data"] }, "flags": { "type": "array", "items": { "type": "string" } } } },
    "operatingContext": { "type": "object", "additionalProperties": false, "required": ["state", "estimated"], "properties": { "state": { "enum": ["steady", "startup", "shutdown", "stopped", "unknown"] }, "estimated": { "type": "boolean" } } },
    "detail": { "type": "object", "additionalProperties": false, "required": ["status", "anomalyScore", "deteriorationScore", "scoreSemantics", "episodeId", "persistenceSeconds"], "properties": { "status": { "enum": ["normal", "watch", "alert", "insufficient_data"] }, "anomalyScore": { "type": "number" }, "deteriorationScore": { "type": "number" }, "scoreSemantics": { "const": "relative_to_historical_baseline_not_failure_probability" }, "episodeId": { "type": ["string", "null"] }, "persistenceSeconds": { "type": "number", "minimum": 0 } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["id", "feature", "value", "unit"], "properties": { "id": { "type": "string", "minLength": 1 }, "feature": { "type": "string", "minLength": 1 }, "value": { "type": "number" }, "unit": { "type": "string", "minLength": 1 }, "baseline": { "type": ["number", "null"] }, "deviation": { "type": ["number", "null"] }, "direction": { "enum": ["up", "down", "stable", "unknown", null] }, "windowSeconds": { "type": ["number", "null"], "minimum": 0 } } },
    "model": { "type": "object", "additionalProperties": false, "required": ["name", "version", "configHash", "trainedUntil"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "configHash": { "$ref": "#/$defs/hash" }, "trainedUntil": { "$ref": "#/$defs/timestamp" } } }
  }
}
