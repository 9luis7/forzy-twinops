{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forzy://contracts/v2/digital-twin-snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asset", "generatedAt", "status", "operationalState", "freshnessBasis", "channels", "history", "assessment", "integration", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "asset": { "$ref": "#/$defs/asset" },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["normal", "watch", "alert", "unknown", "insufficient_data"] },
    "operationalState": { "enum": ["received_now", "last_known", "expected_idle", "unavailable"] },
    "freshnessBasis": { "enum": ["retrieval_time", "last_received", "schedule", "none"] },
    "channels": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "forzy://contracts/v2/sensor-telemetry-frame" },
      "allOf": [
        { "contains": { "type": "object", "required": ["sensorId"], "properties": { "sensorId": { "const": "s1" } } } },
        { "contains": { "type": "object", "required": ["sensorId"], "properties": { "sensorId": { "const": "s2" } } } }
      ]
    },
    "history": { "type": "array", "items": { "$ref": "forzy://contracts/v2/sensor-telemetry-frame" } },
    "assessment": { "anyOf": [{ "const": null }, { "$ref": "forzy://contracts/v2/asset-condition-assessment" }] },
    "integration": { "$ref": "#/$defs/integration" },
    "capabilities": { "$ref": "#/$defs/capabilities" }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "timestampOrNull": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "const": null }] },
    "asset": { "type": "object", "additionalProperties": false, "required": ["assetId", "displayName", "officialTag"], "properties": { "assetId": { "const": "forzy-motor-01" }, "displayName": { "const": "Conjunto motor-bomba monitorado" }, "officialTag": { "const": null } } },
    "sensorHealth": { "type": "object", "additionalProperties": false, "required": ["lastAttemptAt", "lastSuccessAt", "latencyMs", "error", "sampleCount"], "properties": { "lastAttemptAt": { "$ref": "#/$defs/timestampOrNull" }, "lastSuccessAt": { "$ref": "#/$defs/timestampOrNull" }, "latencyMs": { "type": ["number", "null"], "minimum": 0 }, "error": { "enum": ["upstream_unavailable", "invalid_payload", null] }, "sampleCount": { "type": "integer", "minimum": 0 } } },
    "integration": { "type": "object", "additionalProperties": false, "required": ["sensors"], "properties": { "sensors": { "type": "object", "additionalProperties": false, "required": ["s1", "s2"], "properties": { "s1": { "$ref": "#/$defs/sensorHealth" }, "s2": { "$ref": "#/$defs/sensorHealth" } } } } },
    "capabilities": { "type": "object", "additionalProperties": false, "required": ["liveUpdates", "replayControls", "copilot", "twin3d"], "properties": { "liveUpdates": { "const": true }, "replayControls": { "const": false }, "copilot": { "const": false }, "twin3d": { "type": "boolean" } } }
  }
}
