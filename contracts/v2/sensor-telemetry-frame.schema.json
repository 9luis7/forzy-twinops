{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forzy://contracts/v2/sensor-telemetry-frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frameId", "assetId", "sensorId", "observedAt", "receivedAt", "timestampQuality", "measurements", "qualityFlags"],
  "properties": {
    "schemaVersion": { "const": "2.0" }, "frameId": { "$ref": "#/$defs/uuid" }, "assetId": { "const": "forzy-motor-01" }, "sensorId": { "enum": ["s1", "s2"] },
    "observedAt": { "$ref": "#/$defs/timestampOrNull" }, "receivedAt": { "$ref": "#/$defs/timestampOrNull" }, "timestampQuality": { "enum": ["assumed_from_retrieval", "unavailable"] },
    "measurements": { "$ref": "#/$defs/measurements" }, "qualityFlags": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "timestampOrNull": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "const": null }] },
    "measurements": {
      "type": "object", "additionalProperties": false, "required": ["vibrationVelocityRms", "vibrationAcceleration", "temperature"],
      "properties": { "vibrationVelocityRms": { "anyOf": [{ "$ref": "#/$defs/velocity" }, { "const": null }] }, "vibrationAcceleration": { "anyOf": [{ "$ref": "#/$defs/acceleration" }, { "const": null }] }, "temperature": { "anyOf": [{ "$ref": "#/$defs/temperature" }, { "const": null }] } }
    },
    "velocity": { "type": "object", "additionalProperties": false, "required": ["value", "unit", "semanticConfidence"], "properties": { "value": { "type": "number" }, "unit": { "const": "mm/s" }, "semanticConfidence": { "$ref": "#/$defs/confidence" } } },
    "acceleration": { "type": "object", "additionalProperties": false, "required": ["value", "unit", "statistic", "semanticConfidence"], "properties": { "value": { "type": "number" }, "unit": { "const": "g" }, "statistic": { "const": "unknown" }, "semanticConfidence": { "$ref": "#/$defs/confidence" } } },
    "temperature": { "type": "object", "additionalProperties": false, "required": ["value", "unit", "semanticConfidence"], "properties": { "value": { "type": "number" }, "unit": { "const": "degC" }, "semanticConfidence": { "$ref": "#/$defs/confidence" } } },
    "confidence": { "enum": ["confirmed", "inferred_from_datasheet", "unconfirmed"] }
  }
}
