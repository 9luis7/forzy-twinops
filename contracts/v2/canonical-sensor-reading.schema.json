{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forzy://contracts/v2/canonical-sensor-reading",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "readingId", "source", "assetId", "sensorId", "scheduledAt", "observedAt", "receivedAt", "timestampQuality", "measurements", "qualityFlags", "payloadHash", "raw", "provenance"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "readingId": { "$ref": "#/$defs/uuid" },
    "source": { "const": "forzy-live" },
    "assetId": { "const": "forzy-motor-01" },
    "sensorId": { "enum": ["s1", "s2"] },
    "scheduledAt": { "$ref": "#/$defs/timestamp" },
    "observedAt": { "$ref": "#/$defs/timestamp" },
    "receivedAt": { "$ref": "#/$defs/timestamp" },
    "timestampQuality": { "const": "assumed_from_retrieval" },
    "measurements": { "$ref": "#/$defs/measurements" },
    "qualityFlags": { "type": "array", "items": { "type": "string" } },
    "payloadHash": { "$ref": "#/$defs/hash" },
    "raw": { "type": "object", "additionalProperties": false },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSystem", "ingestedAt", "sourceTimestampProvided"],
      "properties": {
        "sourceSystem": { "const": "forzy-api" },
        "ingestedAt": { "$ref": "#/$defs/timestamp" },
        "sourceTimestampProvided": { "const": false }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vibrationVelocityRms", "vibrationAcceleration", "temperature"],
      "properties": {
        "vibrationVelocityRms": { "$ref": "#/$defs/velocity" },
        "vibrationAcceleration": { "$ref": "#/$defs/acceleration" },
        "temperature": { "$ref": "#/$defs/temperature" }
      }
    },
    "velocity": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "semanticConfidence"],
      "properties": { "value": { "type": "number" }, "unit": { "const": "mm/s" }, "semanticConfidence": { "$ref": "#/$defs/confidence" } }
    },
    "acceleration": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "statistic", "semanticConfidence"],
      "properties": { "value": { "type": "number" }, "unit": { "const": "g" }, "statistic": { "const": "unknown" }, "semanticConfidence": { "$ref": "#/$defs/confidence" } }
    },
    "temperature": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "semanticConfidence"],
      "properties": { "value": { "type": "number" }, "unit": { "const": "degC" }, "semanticConfidence": { "$ref": "#/$defs/confidence" } }
    },
    "confidence": { "enum": ["confirmed", "inferred_from_datasheet", "unconfirmed"] }
  }
}
