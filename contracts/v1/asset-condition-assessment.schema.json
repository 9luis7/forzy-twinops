{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forzy://contracts/v1/asset-condition-assessment",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "assetTag", "sensorId", "window", "quality", "operatingContext", "assessment", "componentTag", "recommendation", "humanValidationRequired", "evidence", "model", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "assessmentId": { "$ref": "#/$defs/uuid" }, "assetTag": { "type": "string", "minLength": 1 }, "sensorId": { "enum": ["s1", "s2"] }, "window": { "$ref": "#/$defs/window" }, "quality": { "$ref": "#/$defs/quality" }, "operatingContext": { "type": "object", "additionalProperties": false, "required": ["state", "estimated"], "properties": { "state": { "enum": ["steady", "startup", "shutdown", "stopped", "unknown"] }, "estimated": { "type": "boolean" } } }, "assessment": { "$ref": "#/$defs/detail" }, "componentTag": { "type": ["string", "null"] }, "recommendation": { "type": ["string", "null"] }, "humanValidationRequired": { "type": "boolean" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }, "model": { "$ref": "#/$defs/model" }, "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" }, "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "window": { "type": "object", "additionalProperties": false, "required": ["start", "end", "receivedAt", "freshnessMs"], "properties": { "start": { "$ref": "#/$defs/timestamp" }, "end": { "$ref": "#/$defs/timestamp" }, "receivedAt": { "$ref": "#/$defs/timestamp" }, "freshnessMs": { "type": "number", "minimum": 0 } } }, "quality": { "type": "object", "additionalProperties": false, "required": ["status", "flags"], "properties": { "status": { "enum": ["ok", "degraded", "insufficient_data"] }, "flags": { "type": "array", "items": { "type": "string" } } } },
    "detail": { "type": "object", "additionalProperties": false, "required": ["status", "anomalyScore", "deteriorationScore", "scoreSemantics", "episodeId", "persistenceSeconds"], "properties": { "status": { "enum": ["normal", "watch", "alert", "insufficient_data"] }, "anomalyScore": { "type": "number" }, "deteriorationScore": { "type": "number" }, "scoreSemantics": { "const": "relative_to_historical_baseline_not_failure_probability" }, "episodeId": { "type": ["string", "null"] }, "persistenceSeconds": { "type": "number", "minimum": 0 }, "scoreCalculation": {"anyOf": [{"type": "null"}, {"additionalProperties": false, "properties": {"aggregation": {"const": "maximum_not_sum", "default": "maximum_not_sum", "title": "Aggregation", "type": "string"}, "robustZAtScore100": {"exclusiveMinimum": 0, "title": "Robustzatscore100", "type": "number"}, "positiveDistanceScore": {"maximum": 100, "minimum": 0, "title": "Positivedistancescore", "type": "number"}, "previousDeteriorationScore": {"maximum": 100, "minimum": 0, "title": "Previousdeteriorationscore", "type": "number"}, "ewmaAlpha": {"exclusiveMinimum": 0, "maximum": 1, "title": "Ewmaalpha", "type": "number"}, "watchThreshold": {"maximum": 100, "minimum": 0, "title": "Watchthreshold", "type": "number"}, "alertThreshold": {"maximum": 100, "minimum": 0, "title": "Alertthreshold", "type": "number"}, "persistenceRequiredSeconds": {"minimum": 0, "title": "Persistencerequiredseconds", "type": "number"}, "shortWindowSeconds": {"exclusiveMinimum": 0, "title": "Shortwindowseconds", "type": "number"}, "longWindowSeconds": {"exclusiveMinimum": 0, "title": "Longwindowseconds", "type": "number"}}, "required": ["robustZAtScore100", "positiveDistanceScore", "previousDeteriorationScore", "ewmaAlpha", "watchThreshold", "alertThreshold", "persistenceRequiredSeconds", "shortWindowSeconds", "longWindowSeconds"], "title": "ScoreCalculation", "type": "object"}]} } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["id", "feature", "value", "unit"], "properties": { "id": { "type": "string", "minLength": 1 }, "feature": { "type": "string", "minLength": 1 }, "value": { "type": "number" }, "unit": { "type": "string", "minLength": 1 }, "baseline": { "type": ["number", "null"] }, "deviation": { "type": ["number", "null"] }, "direction": { "enum": ["up", "down", "stable", "unknown", null] }, "windowSeconds": { "type": ["number", "null"], "minimum": 0 }, "robustScale": {"type": ["number", "null"], "exclusiveMinimum": 0}, "normalizedDistance": {"type": ["number", "null"]}, "anomalyScoreComponent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "positiveScoreComponent": {"type": ["number", "null"], "minimum": 0, "maximum": 100} } },
    "model": { "type": "object", "additionalProperties": false, "required": ["name", "version", "configHash", "trainedUntil"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "configHash": { "$ref": "#/$defs/hash" }, "trainedUntil": { "$ref": "#/$defs/timestamp" } } }
  }
}
