{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "forzy://contracts/v1/digital-twin-snapshot", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "assetTag", "mode", "generatedAt", "status", "freshness", "channels", "history", "assessment", "capabilities"],
  "properties": { "schemaVersion": { "const": "1.0" }, "assetTag": { "type": "string", "minLength": 1 }, "mode": { "enum": ["replay", "live"] }, "generatedAt": { "$ref": "#/$defs/timestamp" }, "status": { "enum": ["normal", "watch", "alert", "unknown", "insufficient_data"] }, "freshness": { "enum": ["fresh", "delayed", "expected_idle", "unavailable", "unknown"] }, "channels": { "type": "array", "items": { "$ref": "forzy://contracts/v1/sensor-telemetry-frame" } }, "history": { "type": "array", "items": { "$ref": "forzy://contracts/v1/sensor-telemetry-frame" } }, "assessment": { "anyOf": [{ "const": null }, { "$ref": "forzy://contracts/v1/asset-condition-assessment" }] }, "capabilities": { "$ref": "#/$defs/capabilities" } },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "live" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "channels": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "allOf": [
              { "contains": { "type": "object", "required": ["sensorId"], "properties": { "sensorId": { "const": "s1" } } } },
              { "contains": { "type": "object", "required": ["sensorId"], "properties": { "sensorId": { "const": "s2" } } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": { "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" }, "capabilities": { "type": "object", "additionalProperties": false, "required": ["replayControls", "liveUpdates", "copilot", "twin3d"], "properties": { "replayControls": { "type": "boolean" }, "liveUpdates": { "type": "boolean" }, "copilot": { "type": "boolean" }, "twin3d": { "type": "boolean" } } } }
}
