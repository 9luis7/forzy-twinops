{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forzy://contracts/v1/detection-assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inferenceId", "assetTag", "sensorId", "window", "quality", "operatingContext", "assessment", "componentTag", "recommendation", "humanValidationRequired", "evidence", "model", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "inferenceId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "assetTag": { "type": "string", "minLength": 1 },
    "sensorId": { "enum": ["s1", "s2"] },
    "window": { "$ref": "#/$defs/window" },
    "quality": { "$ref": "#/$defs/quality" },
    "operatingContext": { "$ref": "#/$defs/operatingContext" },
    "assessment": { "$ref": "#/$defs/assessment" },
    "componentTag": { "type": ["string", "null"] },
    "recommendation": { "type": ["string", "null"] },
    "humanValidationRequired": { "type": "boolean" },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false } },
    "model": { "$ref": "#/$defs/model" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "isoTimestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "window": { "type": "object", "additionalProperties": false, "required": ["start", "end", "receivedAt", "freshnessMs"], "properties": { "start": { "$ref": "#/$defs/isoTimestamp" }, "end": { "$ref": "#/$defs/isoTimestamp" }, "receivedAt": { "$ref": "#/$defs/isoTimestamp" }, "freshnessMs": { "type": "number", "minimum": 0 } } },
    "quality": { "type": "object", "additionalProperties": false, "required": ["status", "flags"], "properties": { "status": { "enum": ["ok", "degraded", "insufficient_data"] }, "flags": { "type": "array", "items": { "type": "string" } } } },
    "operatingContext": { "type": "object", "additionalProperties": false, "required": ["state", "estimated"], "properties": { "state": { "enum": ["steady", "startup", "shutdown", "stopped", "unknown"] }, "estimated": { "type": "boolean" } } },
    "assessment": { "type": "object", "additionalProperties": false, "required": ["status", "anomalyScore", "deteriorationScore", "scoreSemantics", "episodeId", "persistenceSeconds"], "properties": { "status": { "enum": ["normal", "watch", "alert", "insufficient_data"] }, "anomalyScore": { "type": "number" }, "deteriorationScore": { "type": "number" }, "scoreSemantics": { "const": "relative_to_historical_baseline_not_failure_probability" }, "episodeId": { "type": ["string", "null"] }, "persistenceSeconds": { "type": "number", "minimum": 0 } } },
    "model": { "type": "object", "additionalProperties": false, "required": ["name", "version", "configHash", "trainedUntil"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "configHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "trainedUntil": { "$ref": "#/$defs/isoTimestamp" } } }
  }
}
