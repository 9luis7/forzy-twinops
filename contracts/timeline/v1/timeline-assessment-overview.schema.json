{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forzy://contracts/timeline/v1/timeline-assessment-overview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "activeHistoricalBatchId",
    "requestedRange",
    "effectiveRange",
    "materialization",
    "aggregationSummary",
    "series"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "assetId": { "const": "forzy-motor-01" },
    "activeHistoricalBatchId": {
      "oneOf": [{ "$ref": "#/definitions/hash" }, { "type": "null" }]
    },
    "requestedRange": { "$ref": "#/definitions/requestedRange" },
    "effectiveRange": {
      "oneOf": [{ "$ref": "#/definitions/halfOpenRange" }, { "type": "null" }]
    },
    "materialization": { "$ref": "#/definitions/materialization" },
    "aggregationSummary": { "$ref": "#/definitions/aggregationSummary" },
    "series": {
      "type": "array",
      "items": { "$ref": "#/definitions/series" }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "activeHistoricalBatchId": { "type": "null" },
        "effectiveRange": { "type": "null" },
        "materialization": {
          "type": "object",
          "properties": {
            "state": { "const": "no_active_historical_batch" },
            "assessmentCount": { "const": 0 },
            "assessmentManifestSha256": { "type": "null" }
          }
        },
        "series": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "type": "object",
      "properties": {
        "activeHistoricalBatchId": { "$ref": "#/definitions/hash" },
        "effectiveRange": { "type": "null" },
        "materialization": {
          "type": "object",
          "properties": {
            "state": { "const": "not_materialized" },
            "assessmentCount": { "const": 0 },
            "assessmentManifestSha256": { "type": "null" }
          }
        },
        "series": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "type": "object",
      "properties": {
        "activeHistoricalBatchId": { "$ref": "#/definitions/hash" },
        "effectiveRange": { "$ref": "#/definitions/halfOpenRange" },
        "materialization": {
          "type": "object",
          "properties": {
            "state": { "const": "materialized" },
            "assessmentCount": { "type": "integer", "minimum": 1 },
            "assessmentManifestSha256": { "$ref": "#/definitions/hash" }
          }
        },
        "series": { "type": "array", "minItems": 1 }
      }
    }
  ],
  "definitions": {
    "uuid5": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "requestedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "oneOf": [{ "$ref": "#/definitions/timestamp" }, { "type": "null" }] },
        "to": { "oneOf": [{ "$ref": "#/definitions/timestamp" }, { "type": "null" }] }
      }
    },
    "halfOpenRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/definitions/timestamp" },
        "to": { "$ref": "#/definitions/timestamp" }
      }
    },
    "closedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/definitions/timestamp" },
        "end": { "$ref": "#/definitions/timestamp" }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "assessmentCount", "assessmentManifestSha256"],
      "properties": {
        "state": {
          "enum": ["no_active_historical_batch", "not_materialized", "materialized"]
        },
        "assessmentCount": { "type": "integer", "minimum": 0 },
        "assessmentManifestSha256": {
          "oneOf": [{ "$ref": "#/definitions/hash" }, { "type": "null" }]
        }
      }
    },
    "aggregationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedMaxPoints",
        "originalAssessmentCount",
        "returnedAssessmentCount",
        "omittedAssessmentCount",
        "reducedSeriesCount"
      ],
      "properties": {
        "requestedMaxPoints": { "type": "integer", "minimum": 40, "maximum": 4000 },
        "originalAssessmentCount": { "type": "integer", "minimum": 0 },
        "returnedAssessmentCount": { "type": "integer", "minimum": 0 },
        "omittedAssessmentCount": { "type": "integer", "minimum": 0 },
        "reducedSeriesCount": { "type": "integer", "minimum": 0 }
      }
    },
    "seriesAggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "requestedMaxPoints",
        "originalAssessmentCount",
        "returnedAssessmentCount",
        "omittedAssessmentCount"
      ],
      "properties": {
        "method": { "enum": ["none", "time_bucket_envelope_v1"] },
        "requestedMaxPoints": { "type": "integer", "minimum": 40, "maximum": 4000 },
        "originalAssessmentCount": { "type": "integer", "minimum": 1 },
        "returnedAssessmentCount": { "type": "integer", "minimum": 1 },
        "omittedAssessmentCount": { "type": "integer", "minimum": 0 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessmentId",
        "anchorPointId",
        "eventAt",
        "anomalyScore",
        "deteriorationScore",
        "status",
        "qualityStatus",
        "candidateState"
      ],
      "properties": {
        "assessmentId": { "$ref": "#/definitions/uuid5" },
        "anchorPointId": { "$ref": "#/definitions/uuid5" },
        "eventAt": { "$ref": "#/definitions/timestamp" },
        "anomalyScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "deteriorationScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "status": { "enum": ["normal", "watch", "alert", "insufficient_data"] },
        "qualityStatus": { "enum": ["ok", "degraded", "insufficient_data"] },
        "candidateState": {
          "oneOf": [{ "const": "candidate_not_ground_truth" }, { "type": "null" }]
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": { "enum": ["watch", "alert"] },
            "anomalyScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "deteriorationScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "candidateState": { "const": "candidate_not_ground_truth" }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": { "const": "normal" },
            "anomalyScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "deteriorationScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "candidateState": { "type": "null" }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": { "const": "insufficient_data" },
            "anomalyScore": { "type": "null" },
            "deteriorationScore": { "type": "null" },
            "candidateState": { "type": "null" }
          }
        }
      ]
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seriesId",
        "segmentId",
        "sensorId",
        "modelFamily",
        "modelVersion",
        "modelHash",
        "foldId",
        "foldHash",
        "reportHash",
        "scoreSemantics",
        "trainingWindow",
        "humanValidationRequired",
        "groundTruthLabelsAvailable",
        "limitations",
        "aggregation",
        "points"
      ],
      "properties": {
        "seriesId": { "$ref": "#/definitions/uuid5" },
        "segmentId": { "$ref": "#/definitions/uuid5" },
        "sensorId": { "enum": ["s1", "s2"] },
        "modelFamily": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "modelHash": { "$ref": "#/definitions/hash" },
        "foldId": { "type": "string", "minLength": 1 },
        "foldHash": { "$ref": "#/definitions/hash" },
        "reportHash": { "$ref": "#/definitions/hash" },
        "scoreSemantics": {
          "const": "relative_to_walk_forward_historical_baseline_not_failure_probability"
        },
        "trainingWindow": { "$ref": "#/definitions/closedRange" },
        "humanValidationRequired": { "const": true },
        "groundTruthLabelsAvailable": { "const": false },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "aggregation": { "$ref": "#/definitions/seriesAggregation" },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/point" }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["points"],
            "properties": {
              "points": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": ["candidateState"],
                  "properties": {
                    "candidateState": { "const": "candidate_not_ground_truth" }
                  }
                }
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "limitations": {
                "type": "array",
                "minItems": 1,
                "contains": { "const": "candidate_not_ground_truth" }
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "limitations": {
                "type": "array",
                "not": {
                  "contains": { "const": "candidate_not_ground_truth" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
