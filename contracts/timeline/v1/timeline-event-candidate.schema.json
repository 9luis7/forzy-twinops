{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forzy://contracts/timeline/v1/timeline-event-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "candidateId", "anchorPointId", "operatingCycleId", "sensorId",
    "eventAt", "sourceKind", "status", "persistenceCount", "episodeStartedAt",
    "dataTrust", "quality", "batchId", "modelFamily", "modelVersion", "foldId",
    "candidateRankingVersion"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "candidateId": { "$ref": "#/definitions/uuid5" },
    "anchorPointId": { "$ref": "#/definitions/uuid5" },
    "operatingCycleId": {
      "oneOf": [{ "$ref": "#/definitions/uuid5" }, { "type": "null" }]
    },
    "sensorId": { "enum": ["s1", "s2"] },
    "eventAt": { "$ref": "#/definitions/timestamp" },
    "sourceKind": { "enum": ["historical_archive", "live_collection"] },
    "status": { "enum": ["watch", "alert"] },
    "persistenceCount": { "type": "integer", "minimum": 1 },
    "episodeStartedAt": { "$ref": "#/definitions/timestamp" },
    "dataTrust": { "enum": ["sufficient", "degraded", "insufficient"] },
    "quality": { "$ref": "#/definitions/quality" },
    "batchId": {
      "oneOf": [{ "$ref": "#/definitions/hash" }, { "type": "null" }]
    },
    "modelFamily": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "foldId": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "candidateRankingVersion": { "const": "forzy-review-priority-v1" }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "sourceKind": { "const": "historical_archive" },
        "operatingCycleId": { "$ref": "#/definitions/uuid5" },
        "batchId": { "$ref": "#/definitions/hash" },
        "foldId": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "properties": {
        "sourceKind": { "const": "live_collection" },
        "operatingCycleId": {
          "oneOf": [{ "$ref": "#/definitions/uuid5" }, { "type": "null" }]
        },
        "batchId": { "type": "null" },
        "foldId": { "type": "null" }
      }
    }
  ],
  "definitions": {
    "uuid5": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "flags"],
      "properties": {
        "status": { "enum": ["ok", "degraded", "insufficient_data"] },
        "flags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
